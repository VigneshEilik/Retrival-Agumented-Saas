# Local development configuration for the backend. Copy to backend/.env.
# For production values see ../.env.production.example and docs/deployment.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Application role: must NOT be a superuser or have BYPASSRLS, otherwise
# PostgreSQL Row-Level Security (tenant isolation) is silently skipped.
# Create it with: psql ... -f scripts/db/setup-app-role.sql (see docs/development)
DATABASE_URL=postgres://rag_app:CHANGE_ME@127.0.0.1:5432/rag_saas_db
# Schema owner used only to apply migrations (superuser or BYPASSRLS)
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/rag_saas_db
RUN_MIGRATIONS_ON_START=true

REDIS_URL=redis://localhost:6379

# --- Auth -----------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- HTTP -----------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (required in production)
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
# STORAGE_DIR=./storage_data

# --- AI providers ---------------------------------------------------------
# Get a key at https://console.groq.com/keys (leave empty to use the mock LLM)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=60000
# local = real semantic embeddings computed on this machine (no key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDING_CACHE_DIR=./models
# Run the ingestion worker inside the API process (set false when running the worker separately)
RUN_INGESTION_WORKER=true
