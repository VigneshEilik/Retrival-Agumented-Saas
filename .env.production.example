# Production environment template for docker-compose.yml
# Copy to .env.production, fill in every value, and NEVER commit the filled file.
# Generate secrets with:  openssl rand -base64 48   (or)   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- PostgreSQL ---------------------------------------------------------
# Schema owner (runs migrations only)
POSTGRES_USER=rag_owner
POSTGRES_PASSWORD=
POSTGRES_DB=rag_saas_db
# Least-privilege application role (all API/worker queries; RLS enforced)
APP_DB_USER=rag_app
APP_DB_PASSWORD=

# --- Auth ---------------------------------------------------------------
# Two DIFFERENT random values, 32+ characters each
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- HTTP ---------------------------------------------------------------
# Public origin(s) of the frontend, comma-separated, e.g. https://app.example.com
CORS_ORIGINS=
# Proxy hops in front of the API: TLS reverse proxy + Next.js = 2 (use 1 if nothing sits in front of the frontend)
TRUST_PROXY=2
FRONTEND_PORT=3000

# --- AI providers -------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

LOG_LEVEL=info
